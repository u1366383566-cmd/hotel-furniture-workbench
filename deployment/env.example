# 环境变量说明（部署到 /etc/hotel-furniture-workbench/env，权限 root:workbench 0640）
# 密钥红线：不进入前端；不进入 Git；不进入日志；不读取 90 运行容器中的现有密钥。

# ---- 存储与数据库（计划第十二节：SQLite WAL 作为真实任务账本）----
WORKBENCH_STORAGE_DIR=/var/lib/hotel-furniture-workbench
# 也可显式指定数据库文件（默认 $WORKBENCH_STORAGE_DIR/db/workbench.db）
# WORKBENCH_DB_PATH=/var/lib/hotel-furniture-workbench/db/workbench.db

# ---- 身份信任模式（计划第十五节）----
# 生产必须为 trusted_proxy：缺失身份头的请求一律 401，
# 身份头只能由 nginx auth_request 校验 JWT 后注入。
WORKBENCH_AUTH_MODE=trusted_proxy

# ---- 运行开关（保持默认，计划红线：不得自动开启）----
# Worker 后台循环默认开启；测试隔离时才设为 1，生产禁止设置
# WORKBENCH_DISABLE_WORKER_LOOP=0

# ---- 第一阶段 Mock 声明（代码内固定，勿改）----
# MOCK_MODE=True / ALLOW_REMOTE_NETWORK=False 为第一阶段强约束

# ---- 第三阶段：真实生图上游（经 SSH 隧道，绑定本机）----
# 仅在第二阶段接口契约核验通过后启用；密钥从本文件读取，禁止写入代码库
# UPSTREAM_IMAGE_API_BASE=http://127.0.0.1:8021
# UPSTREAM_IMAGE_API_KEY=<由负责人保管的独立密钥，不是90容器内现有密钥>
